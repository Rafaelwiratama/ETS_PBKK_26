<Window x:Class="Slashers.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slashers — Game Store Management" Icon="pack://application:,,,/Assets/Slashers_AppIcon.png" Height="820" Width="1440" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#171A22" BorderBrush="#394251" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,18">
                    <Border Background="#171A22" BorderBrush="#394251" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,10">
                        <Image Source="Assets/Slashers_Logo_Primary.png" Height="66" Width="205" Stretch="Uniform" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GAME STORE MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentTealBrush}" TextAlignment="Center" Margin="0,2,0,2" />
                    <TextBlock Text="PIXEL-BLOCK INVENTORY SYSTEM" FontSize="8" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" />
                    <Border Height="1" Background="#394251" Margin="5,20,5,9" />
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" Margin="8,5,0,8" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,18">
                    <Border Height="1" Background="#394251" Margin="0,0,0,12" />
                    <TextBlock Text="SLASHERS WORKSPACE" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="Slashers • .NET 8 WPF" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                    <TextBlock Text="Your collection. Fully in control." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,0">
                        <Button Content="▦    Dashboard" Tag="Dashboard" Click="Nav_Click" Style="{StaticResource {x:Type Button}}" Margin="0,2,0,5" HorizontalContentAlignment="Left" />
                        <Button Content="▧    Katalog Game" Tag="Catalog" Click="Nav_Click" Margin="0,2,0,5" HorizontalContentAlignment="Left" />
                        <Button Content="↗    Transaksi" Tag="Transactions" Click="Nav_Click" Margin="0,2,0,5" HorizontalContentAlignment="Left" />
                        <Button Content="▤    Riwayat Transaksi" Tag="History" Click="Nav_Click" Margin="0,2,0,5" HorizontalContentAlignment="Left" />
                        <Button Content="!    Stok Kritis" Tag="Stock" Click="Nav_Click" Margin="0,2,0,5" HorizontalContentAlignment="Left" />
                        <Button Content="◈    Mitra Toko" Tag="Partners" Click="Nav_Click" Margin="0,2,0,5" HorizontalContentAlignment="Left" />
                        <Button Content="▥    Laporan" Tag="Reports" Click="Nav_Click" Margin="0,2,0,5" HorizontalContentAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="25,22,25,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0,0,0,18" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="10" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource AccentTealBrush}" Margin="0,1,0,1" />
                    <StackPanel Grid.Column="1" Margin="15,0,18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="Dashboard" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PageSubtitleText" Text="Your game store, organized." Foreground="{StaticResource AccentAmberBrush}" FontSize="12" Margin="1,5,0,0" />
                        <TextBlock Text="SLASHERS     •     CATALOG / INVENTORY / SALES" Foreground="#929BA8" FontSize="9" Margin="1,9,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#202631" BorderBrush="#394251" BorderThickness="1" Padding="14,9" MinWidth="188" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="LOCAL WORKSPACE" Foreground="{StaticResource AccentAmberBrush}" FontFamily="Segoe UI" FontSize="11" TextAlignment="Right" />
                            <TextBlock x:Name="TodayText" Text="MINGGU, 18 OKTOBER 2026" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Right" FontSize="11" Margin="0,5,0,0" />
                            <TextBlock Text="Everything you track, in one place." Foreground="#929BA8" FontStyle="Italic" TextAlignment="Right" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- DASHBOARD -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Slashers pixel-block identity and dashboard overview -->
                        <Border Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <Grid MinHeight="118">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="Assets/Slashers_AppIcon.png" Width="96" Height="96" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                    <TextBlock Text="YOUR GAME STORE AT A GLANCE" Foreground="{StaticResource AccentAmberBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="Your game store, organized." FontFamily="Segoe UI" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="Kelola katalog, transaksi, dan inventaris dari satu ruang kerja." Foreground="#929BA8" FontSize="11" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#20BFA9" Margin="0,12,25,0" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#171A22" BorderBrush="#394251" BorderThickness="1" Padding="13" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SLASHERS PRINCIPLE" Foreground="{StaticResource AccentAmberBrush}" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="Collect. Track. Grow." FontFamily="Segoe UI" FontSize="18" Foreground="{StaticResource AccentTealBrush}" Margin="0,8,0,5" TextWrapping="Wrap" />
                                        <TextBlock Text="Every game, every stock, one place." Foreground="#929BA8" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Main statistics -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,9,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" BorderBrush="#596575" BorderThickness="1" Background="#252E3B" VerticalAlignment="Top"><TextBlock Text="▣" FontSize="17" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="GAME DALAM KATALOG" Foreground="{StaticResource AccentAmberBrush}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="StatGames" Text="0" FontFamily="Segoe UI" FontSize="29" Margin="0,8,0,3"/><TextBlock Text="Judul terdaftar" Foreground="#929BA8" FontSize="10"/></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,9,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" BorderBrush="#596575" BorderThickness="1" Background="#252E3B" VerticalAlignment="Top"><TextBlock Text="▤" FontSize="17" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="TOTAL UNIT STOK" Foreground="{StaticResource AccentAmberBrush}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="StatStock" Text="0" FontFamily="Segoe UI" FontSize="29" Margin="0,8,0,3"/><TextBlock Text="Unit siap dijual" Foreground="#929BA8" FontSize="10"/></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="#26333B" BorderBrush="#20BFA9" BorderThickness="1" Padding="13" Margin="0,0,9,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" BorderBrush="#FFC857" BorderThickness="1" Background="#153E3B" VerticalAlignment="Top"><TextBlock Text="◉" FontSize="17" Foreground="#FF647C" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="PENJUALAN HARI INI" Foreground="{StaticResource AccentAmberBrush}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="StatSales" Text="Rp 0" FontFamily="Segoe UI" FontSize="22" Margin="0,11,0,6" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StatTransactions" Text="0 transaksi" Foreground="#929BA8" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="3" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="8" Padding="13">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" BorderBrush="#394251" BorderThickness="1" Background="#25303C" VerticalAlignment="Top"><TextBlock Text="⚠" FontSize="15" Foreground="#FF647C" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="STOK MENIPIS" Foreground="{StaticResource AccentAmberBrush}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="StatLowStock" Text="0" FontFamily="Segoe UI" FontSize="29" Margin="0,8,0,3" Foreground="#FF647C"/><TextBlock Text="Perlu diperiksa (≤ 5)" Foreground="#929BA8" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Weekly sales + restock -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10"><TextBlock Text="PENJUALAN 7 HARI TERAKHIR" FontFamily="Segoe UI" FontSize="16" Foreground="{StaticResource AccentAmberBrush}"/><TextBlock Text="IDR" Foreground="#929BA8" FontSize="9" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
                                    <Border Background="#171A22" BorderBrush="#394251" BorderThickness="1" Padding="9" Height="166">
                                        <ItemsControl x:Name="SalesBars">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="4,2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#171A22" VerticalAlignment="Stretch" />
                                                <Border Grid.Row="0" Background="{StaticResource AccentTealBrush}" Height="{Binding BarHeight}" VerticalAlignment="Bottom" Margin="3,0,3,0" />
                                                <TextBlock Grid.Row="1" Text="{Binding ShortTotal}" FontSize="9" Foreground="{StaticResource AccentAmberBrush}" TextAlignment="Center" Margin="0,6,0,1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="9" Foreground="#929BA8" TextAlignment="Center" Margin="0,4,0,0" />
                                            </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock Text="Ringkasan dihitung dari transaksi yang tersimpan di database." Foreground="#929BA8" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="10" Padding="16" Margin="10,0,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12"><TextBlock Text="PERLU RESTOCK" FontFamily="Segoe UI" FontSize="16" Foreground="{StaticResource AccentAmberBrush}"/><Button Content="Lihat semua  ›" Click="OpenStock_Click" DockPanel.Dock="Right" Padding="8,4" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" FontSize="10"/></DockPanel>
                                    <DataGrid x:Name="LowStockGrid" Height="196"><DataGrid.Columns><DataGridTextColumn Header="GAME" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="PLATFORM" Binding="{Binding Platform}" Width="105"/><DataGridTextColumn Header="STOK" Binding="{Binding Stock}" Width="52"/></DataGrid.Columns></DataGrid>
                                    <TextBlock Text="Stok lima unit atau kurang akan muncul di sini." Foreground="#929BA8" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent inventory activity -->
                        <Border Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,11"><TextBlock Text="AKTIVITAS TERBARU" FontFamily="Segoe UI" FontSize="16" Foreground="{StaticResource AccentAmberBrush}"/><TextBlock Text="LATEST TRANSACTIONS" Foreground="#929BA8" FontSize="9" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
                                <DataGrid x:Name="RecentTransactionsGrid" Height="205"><DataGrid.Columns><DataGridTextColumn Header="TANGGAL" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/><DataGridTextColumn Header="JENIS" Binding="{Binding Type}" Width="115"/><DataGridTextColumn Header="GAME" Binding="{Binding GameTitle}" Width="*"/><DataGridTextColumn Header="JUMLAH" Binding="{Binding Quantity}" Width="75"/><DataGridTextColumn Header="TOTAL (RP)" Binding="{Binding Total, StringFormat=N0}" Width="130"/><DataGridTextColumn Header="PIHAK" Binding="{Binding Partner}" Width="150"/></DataGrid.Columns></DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- CATALOG -->
                <Grid x:Name="CatalogPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Ekspor CSV" Click="ExportCatalog_Click" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="＋ Tambah Game" Click="AddGame_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="Edit" Click="EditGame_Click"/><Button Content="Hapus" Click="DeleteGame_Click"/></StackPanel>
                        <TextBox x:Name="CatalogSearchTextBox" Width="330" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Cari judul, platform, atau genre" TextChanged="CatalogSearchTextBox_TextChanged"/>
                    </DockPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="244"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#202631" BorderBrush="#394251" BorderThickness="1" Padding="7" Margin="0,0,14,0">
                            <ListView x:Name="CatalogGrid" SelectionChanged="CatalogGrid_SelectionChanged" ItemContainerStyle="{StaticResource CatalogCardItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="172" Height="300">
                                            <Grid.RowDefinitions><RowDefinition Height="164"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid Grid.Row="0" ClipToBounds="True" Background="#171A22">
                                                <Image Source="{Binding CoverDisplayPath}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Bottom" Background="#D21B2430" Padding="7,5"><TextBlock Text="SLASHERS  /  GAME COLLECTION" FontSize="8" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" /></Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="10,9,10,8">
                                                <TextBlock Text="{Binding Title}" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" />
                                                <TextBlock Text="{Binding Platform}" Foreground="{StaticResource AccentAmberBrush}" FontSize="10" Margin="0,4,0,8" />
                                                <Border Height="1" Background="#394251" Margin="0,0,0,7" />
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="HARGA JUAL" Foreground="#929BA8" FontSize="8"/><TextBlock Text="{Binding SellPrice, StringFormat={}{0:N0}}" Foreground="{StaticResource AccentTealBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="STOK" Foreground="#929BA8" FontSize="8" TextAlignment="Right"/><TextBlock Text="{Binding Stock}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" TextAlignment="Right" /></StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Genre}" Foreground="#929BA8" FontSize="9" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <Border Grid.Column="1" Background="#202631" BorderBrush="#394251" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="GAME DETAILS" FontFamily="Segoe UI" Foreground="{StaticResource AccentAmberBrush}" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="Selected game dossier" Foreground="#929BA8" FontSize="10" Margin="0,4,0,12" />
                                <Border BorderBrush="#394251" BorderThickness="1" Background="#0D0F10" Height="242" Padding="5"><Image x:Name="CatalogCoverPreview" Stretch="Uniform" /></Border>
                                <TextBlock x:Name="CatalogSelectedTitle" Text="Pilih game dari katalog" FontFamily="Segoe UI" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,6" />
                                <TextBlock x:Name="CatalogSelectedDetails" Text="Sampul, harga, dan stok akan ditampilkan di sini." Foreground="#929BA8" FontSize="11" TextWrapping="Wrap" />
                                <Border Height="1" Background="#394251" Margin="0,13,0,11" />
                                <TextBlock Text="PILIH KARTU UNTUK MELIHAT DETAIL. GUNAKAN TOMBOL EDIT ATAU HAPUS DI ATAS UNTUK MENGUBAH ARSIP." Foreground="{StaticResource AccentAmberBrush}" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- TRANSACTIONS -->
                <ScrollViewer x:Name="TransactionsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="5" Padding="22" Margin="0,0,15,0">
                            <StackPanel><TextBlock Text="CATAT TRANSAKSI" FontFamily="Segoe UI" FontSize="19" Foreground="{StaticResource AccentAmberBrush}"/><TextBlock Text="Stok akan diperbarui secara otomatis setelah transaksi berhasil." Foreground="#929BA8" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,15"/>
                                <Label Content="Jenis Transaksi"/><ComboBox x:Name="TransactionTypeCombo" SelectionChanged="TransactionTypeCombo_SelectionChanged"><ComboBoxItem Content="PENJUALAN" IsSelected="True"/><ComboBoxItem Content="PEMBELIAN"/></ComboBox>
                                <Label Content="Game"/><ComboBox x:Name="TransactionGameCombo" DisplayMemberPath="Title" SelectionChanged="TransactionGameCombo_SelectionChanged"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><Label Content="Jumlah Unit"/><TextBox x:Name="TransactionQuantityText" Text="1" TextChanged="TransactionFields_TextChanged"/></StackPanel><StackPanel Grid.Column="1"><Label Content="Harga per Unit (Rp)"/><TextBox x:Name="TransactionUnitPriceText" TextChanged="TransactionFields_TextChanged"/></StackPanel></Grid>
                                <Label Content="Nama Pelanggan / Supplier"/><TextBox x:Name="TransactionPartnerText"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><Label Content="Diskon (%)"/><TextBox x:Name="TransactionDiscountText" Text="0" TextChanged="TransactionFields_TextChanged"/></StackPanel><StackPanel Grid.Column="1"><Label Content="Metode Pembayaran"/><ComboBox x:Name="TransactionPaymentCombo"><ComboBoxItem Content="Tunai" IsSelected="True"/><ComboBoxItem Content="Transfer"/><ComboBoxItem Content="QRIS"/><ComboBoxItem Content="Kartu"/></ComboBox></StackPanel></Grid>
                                <Border Background="#26333B" BorderBrush="#176F66" BorderThickness="1" CornerRadius="4" Padding="13" Margin="0,10,0,16"><StackPanel><TextBlock Text="TOTAL TRANSAKSI" Foreground="{StaticResource AccentAmberBrush}" FontSize="10"/><TextBlock x:Name="TransactionTotalText" Text="Rp 0" FontFamily="Segoe UI" FontSize="28" Margin="0,6,0,0"/></StackPanel></Border>
                                <Button Content="SIMPAN TRANSAKSI" Click="SaveTransaction_Click" Background="#155F58" Height="42" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#171A22" BorderBrush="#394251" BorderThickness="1" CornerRadius="5" Padding="20">
                            <StackPanel><TextBlock Text="TRANSACTION GUIDE" FontFamily="Segoe UI" FontSize="19" Foreground="{StaticResource AccentAmberBrush}"/><TextBlock Text="Pembelian" FontWeight="Bold" Foreground="#FFC857" Margin="0,20,0,5"/><TextBlock Text="Mencatat stok masuk dari supplier. Stok bertambah setelah transaksi berhasil; diskon tidak diterapkan pada modul pembelian." TextWrapping="Wrap" Foreground="#929BA8"/><TextBlock Text="Penjualan" FontWeight="Bold" Foreground="#FFC857" Margin="0,18,0,5"/><TextBlock Text="Mencatat transaksi pelanggan. Sistem menolak jumlah penjualan yang lebih besar daripada stok yang tersedia." TextWrapping="Wrap" Foreground="#929BA8"/><TextBlock Text="Validasi" FontWeight="Bold" Foreground="#FFC857" Margin="0,18,0,5"/><TextBlock Text="Jumlah harus lebih besar dari nol, nama pihak transaksi wajib diisi, harga tidak boleh negatif, dan diskon harus berada di rentang 0–100%." TextWrapping="Wrap" Foreground="#929BA8"/><Border Height="1" Background="#394251" Margin="0,22,0,15"/><TextBlock Text="Aksi tercatat dalam riwayat transaksi dan ikut dihitung pada dashboard serta laporan." TextWrapping="Wrap" Foreground="{StaticResource AccentAmberBrush}" FontStyle="Italic"/></StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- HISTORY -->
                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12"><Button Content="Ekspor CSV" Click="ExportHistory_Click" DockPanel.Dock="Right"/><ComboBox x:Name="HistoryFilterCombo" Width="190" SelectionChanged="HistoryFilterCombo_SelectionChanged"><ComboBoxItem Content="SEMUA" IsSelected="True"/><ComboBoxItem Content="PENJUALAN"/><ComboBoxItem Content="PEMBELIAN"/></ComboBox></DockPanel>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Tanggal" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="155"/><DataGridTextColumn Header="Jenis" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="Game" Binding="{Binding GameTitle}" Width="*"/><DataGridTextColumn Header="Jumlah" Binding="{Binding Quantity}" Width="70"/><DataGridTextColumn Header="Harga Unit" Binding="{Binding UnitPrice, StringFormat=N0}" Width="110"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N0}" Width="125"/><DataGridTextColumn Header="Pelanggan/Supplier" Binding="{Binding Partner}" Width="170"/><DataGridTextColumn Header="Pembayaran" Binding="{Binding PaymentMethod}" Width="100"/></DataGrid.Columns></DataGrid>
                </Grid>

                <!-- STOCK -->
                <Grid x:Name="StockPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="STOK KRITIS" FontFamily="Segoe UI" FontSize="20" Foreground="{StaticResource AccentAmberBrush}"/><TextBlock Text="Judul dengan stok lima unit atau kurang akan ditandai untuk restock." Foreground="#929BA8" Margin="0,6,0,0"/></StackPanel>
                    <DataGrid x:Name="StockGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="Judul Game" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="180"/><DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="140"/><DataGridTextColumn Header="Harga Beli" Binding="{Binding BuyPrice, StringFormat=N0}" Width="140"/><DataGridTextColumn Header="Stok" Binding="{Binding Stock}" Width="85"/></DataGrid.Columns></DataGrid>
                </Grid>

                <!-- PARTNERS -->
                <Grid x:Name="PartnersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="MITRA TOKO" FontFamily="Segoe UI" FontSize="20" Foreground="{StaticResource AccentAmberBrush}"/><TextBlock Text="Pelanggan dan supplier dirangkum otomatis dari riwayat transaksi." Foreground="#929BA8" Margin="0,6,0,0"/></StackPanel>
                    <DockPanel Grid.Row="1"><Button Content="Ekspor CSV" Click="ExportPartners_Click" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,12"/><DataGrid x:Name="PartnersGrid"><DataGrid.Columns><DataGridTextColumn Header="Nama Pihak" Binding="{Binding Partner}" Width="*"/><DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="170"/><DataGridTextColumn Header="Jumlah Transaksi" Binding="{Binding TransactionCount}" Width="170"/><DataGridTextColumn Header="Total Nilai (Rp)" Binding="{Binding TotalValue, StringFormat=N0}" Width="200"/></DataGrid.Columns></DataGrid></DockPanel>
                </Grid>

                <!-- REPORTS -->
                <ScrollViewer x:Name="ReportsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="5" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="TOTAL PENJUALAN TERCATAT" Foreground="{StaticResource AccentAmberBrush}" FontSize="10"/><TextBlock x:Name="ReportSales" Text="Rp 0" FontFamily="Segoe UI" FontSize="28" Margin="0,9,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Background="#202631" BorderBrush="#394251" BorderThickness="1" CornerRadius="5" Padding="20"><StackPanel><TextBlock Text="TOTAL PEMBELIAN TERCATAT" Foreground="{StaticResource AccentAmberBrush}" FontSize="10"/><TextBlock x:Name="ReportPurchases" Text="Rp 0" FontFamily="Segoe UI" FontSize="28" Margin="0,9,0,0"/></StackPanel></Border>
                    </Grid>
                    <Border Background="#171A22" BorderBrush="#394251" BorderThickness="1" CornerRadius="5" Padding="18"><StackPanel><DockPanel Margin="0,0,0,13"><TextBlock Text="GAME TERLARIS" FontFamily="Segoe UI" FontSize="19" Foreground="{StaticResource AccentAmberBrush}"/><Button Content="Ekspor CSV" Click="ExportReport_Click" DockPanel.Dock="Right"/></DockPanel><DataGrid x:Name="TopSellingGrid" Height="360"><DataGrid.Columns><DataGridTextColumn Header="Judul Game" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Unit Terjual" Binding="{Binding Units}" Width="145"/><DataGridTextColumn Header="Total Penjualan" Binding="{Binding Total, StringFormat=N0}" Width="190"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="StatusText" Text="SLASHERS WORKSPACE • DATABASE READY" FontSize="10" Foreground="#929BA8" Margin="1,12,0,0"/>
        </Grid>
    </Grid>
</Window>
